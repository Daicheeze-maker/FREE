# systemd service for the Aurelune store inside the VM (installed by scripts/vm-setup.sh).
# It starts the store when the VM boots and restarts it automatically if it ever stops.
#   sudo systemctl status aurelune      # is it running?
#   sudo systemctl restart aurelune     # restart
#   journalctl -u aurelune -f           # live log (Ctrl+C to leave)
[Unit]
Description=Aurelune watch store (Flask + Waitress)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
Environment=OPEN_BROWSER=0
# Database schema, catalog and old-version clean-up before every start (never deletes accounts or orders)
ExecStartPre=@DIR@/.venv/bin/python -m flask --app wsgi init-db
ExecStartPre=@DIR@/.venv/bin/python -m flask --app wsgi seed
ExecStartPre=@DIR@/.venv/bin/python -m flask --app wsgi upgrade-demo
ExecStartPre=@DIR@/.venv/bin/python -m flask --app wsgi ensure-admin
ExecStart=@DIR@/.venv/bin/python serve.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
