# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production   (production refuses to start without SECRET_KEY)
VELORA_ENV=development

# Storage (relative paths are resolved from the project folder, not the working directory)
VELORA_DB_PATH=instance/velora.db
VELORA_UPLOAD_DIR=instance/uploads
# DATABASE_URL=sqlite:////absolute/path/to/velora.db
MAX_UPLOAD_MB=4

# Set to 1 only when the site is served over HTTPS
SESSION_COOKIE_SECURE=0

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# External APIs (no keys required). Contact email is sent in the User-Agent, as Open Food Facts asks.
VELORA_CONTACT_EMAIL=you@example.com
OFF_BASE_URL=https://world.openfoodfacts.org
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
FX_CACHE_HOURS=6
HTTP_TIMEOUT=8
API_RETRY_BACKOFF_MINUTES=10

# serve.py: 127.0.0.1 = this machine only; 0.0.0.0 = reachable from other devices (see README)
HOST=127.0.0.1
PORT=5000
