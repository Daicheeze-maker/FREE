# Copy to backend/.env and fill in. Never commit .env. The frontend needs no keys.

# "mock" = local demo gateway (no credentials needed). "paymongo" = real PayMongo test-mode checkout.
PAYMENT_MODE=mock

# PayMongo TEST secret key only, starts with sk_test_ (Dashboard -> Developers -> API keys, test mode). Live keys are refused.
PAYMONGO_SECRET_KEY=
# Secret of the webhook you create for checkout_session.payment.paid and payment.failed (starts with whsk_).
PAYMONGO_WEBHOOK_SECRET=

# Where PayMongo sends the shopper back after paying.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Frankfurter exchange rates (no key required).
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
FRANKFURTER_TIMEOUT=5

DATABASE_URL=sqlite:///./vesper.db
# Enables POST /api/admin/* (header X-Admin-Token). Leave empty to disable admin endpoints.
ADMIN_TOKEN=
