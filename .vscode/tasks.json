{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Velora Market",
      "type": "shell",
      "command": "bash start.sh",
      "windows": { "command": ".\\start.bat" },
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run the tests",
      "type": "shell",
      "command": "python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
